# state-api の環境変数テンプレート。
# 実際の値を入れたものは .env として置く(.gitignore済みでコミットされない)。

BASE_PATH=/akiya-state
PUBLIC_BASE_URL=https://staff.negura.website/akiya-state
APP_ENV=production
APP_NAME=akiya-watch
DATABASE_URL=postgresql://akiya_state_app:PASSWORD@postgres:5432/akiya_state
STATE_KEYS=ken,yumiko,ayako
CORS_ORIGIN=https://neguracg.github.io
MAX_BODY_BYTES=262144

# 同時DB接続数の上限(1-20)。共有PostgreSQLを枯渇させないための安全弁
DB_CONNECTION_LIMIT=5
# 送信元IPあたりのPUT上限(回/分)。1以上
PUT_RATE_LIMIT_MAX=60
# 送信元IPあたりのGET上限(回/分)。1以上
GET_RATE_LIMIT_MAX=60
